{
  "name": "kidstreasure-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"cyan,magenta\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --workspace=@monorepo/client",
    "dev:server": "npm run dev --workspace=@monorepo/server",
    "build": "npm run build --workspace=@monorepo/client",
    "lint": "npm run lint --workspace=@monorepo/client",
    "start": "npm start --workspace=@monorepo/server",
    "server": "npm start --workspace=@monorepo/server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
